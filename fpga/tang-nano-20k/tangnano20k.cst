// tangnano20k.cst -- physical constraints for the Sipeed Tang Nano 20K.
// Pin numbers verified against Sipeed's official pinout and a known-good project
// .cst (calint/tang-nano-20k--riscv--cache-sdram), 2026-08.
//
//   clk       pin 4    27 MHz system clock (PIN04_SYS_CLK)
//   uart_tx   pin 69   FPGA -> host  (PIN69_SYS_TX, to the BL616 bridge)
//   uart_rx   pin 70   host -> FPGA  (PIN70_SYS_RX)
//   led[0..5] pins 15..20  active-LOW LEDs (PIN15..20_SYS_LED0..5)
//   (KEY2 reset button is pin 87 -- not used here; top.v self-resets.)

IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
