// sdram_test.cst -- Stage 0 standalone SDRAM test.
//
// NOTE WHAT IS ABSENT: the SDRAM signals. They are bonded inside the GW2AR
// package and apicula recognises the O_sdram_* / IO_sdram_dq names, so
// constraining them here is neither needed nor possible. See README.md.
IO_LOC  "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_LOC  "uart_txp" 69;
IO_PORT "uart_txp" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
